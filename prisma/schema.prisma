generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── AUTH / USUÁRIOS ─────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senha     String
  role      Role     @default(CADASTRADOR)
  ativo     Boolean  @default(true)
  criadoEm DateTime @default(now())

  lotesCriados Lote[]
}

enum Role {
  CADASTRADOR
  SUPERVISOR
  ADMIN
}

// ─── PROJETO REURB ────────────────────────────────────────────────────────────

model ProjetoReurb {
  id           String   @id @default(cuid())
  nome         String
  municipio    String
  estado       String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  quadras    Quadra[]
  documentos DocumentoProjetoReurb[]
}

model DocumentoProjetoReurb {
  id           String               @id @default(cuid())
  projetoId    String
  projeto      ProjetoReurb         @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  tipo         TipoDocumentoProjeto
  supabasePath String
  nomeOriginal String?
  tamanhoBytes Int?
  enviadoEm    DateTime             @default(now())
}

enum TipoDocumentoProjeto {
  MEMORIAL_DESCRITIVO
  FOTO_PROJETO
  LEVANTAMENTO_TOPOGRAFICO
  RELATORIO_AMBIENTAL
  RELATORIO_URBANISTICO
  RELATORIO_JURIDICO
  RELATORIO_SOCIOECONOMICO
}

// ─── QUADRA ───────────────────────────────────────────────────────────────────

model Quadra {
  id           String       @id @default(cuid())
  projetoId    String
  projeto      ProjetoReurb @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  nome         String
  foto         String?
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  lotes Lote[]
}

// ─── LOTE ─────────────────────────────────────────────────────────────────────

model Lote {
  id                   String           @id @default(cuid())
  quadraId             String
  quadra               Quadra           @relation(fields: [quadraId], references: [id], onDelete: Cascade)
  nomeLote             String
  numeroSelagem        String?
  rua                  String
  numero               String
  complemento          String?
  area                 Float
  areaDaEdificacao     Float
  inscricaoImobiliaria String?
  usoDoLote            UsoDoLote
  tipoDeConstrucao     TipoDeConstrucao
  tipoDeUso            TipoDeUso
  direitoReal          DireitoReal
  observacao           String?
  criadoPorId          String
  criadoPor            User             @relation(fields: [criadoPorId], references: [id])
  criadoEm             DateTime         @default(now())
  atualizadoEm         DateTime         @updatedAt

  proprietario Proprietario?
  documentos   DocumentoLote?
  benfeitorias Benfeitoria?
}

enum UsoDoLote {
  RESIDENCIAL
  COMERCIAL
  MISTO
  INSTITUCIONAL
  INDUSTRIAL
  VAGO
}

enum TipoDeConstrucao {
  ALVENARIA
  MADEIRA
  MISTA
  METALICA
  OUTROS
}

enum TipoDeUso {
  PROPRIO
  ALUGADO
  CEDIDO
  OCUPADO
  OUTROS
}

enum DireitoReal {
  CONCESSAO_USO
  CONCESSAO_REAL_USO
  LEGITIMACAO_FUNDIARIA
  USUCAPIAO
  OUTROS
}

// ─── PROPRIETÁRIO ─────────────────────────────────────────────────────────────

model Proprietario {
  id                    String      @id @default(cuid())
  loteId                String      @unique
  lote                  Lote        @relation(fields: [loteId], references: [id], onDelete: Cascade)
  nome                  String
  nomeSocial            String?
  cpf                   String      @unique
  rg                    String?
  nis                   String?
  cnpj                  String?
  email                 String?
  celular               String
  celular2              String?
  filiacaoMaterna       String?
  filiacaoPaterna       String?
  estadoCivil           EstadoCivil
  profissao             String
  rendaIndividualMensal Float
  rendaFamiliarMensal   Float
  recebeBolsaFamilia    Boolean     @default(false)
  recebeBPC             Boolean     @default(false)
  isPCD                 Boolean     @default(false)
  temPCDNaMoradia       Boolean     @default(false)
  observacoes           String?
  criadoEm              DateTime    @default(now())
  atualizadoEm          DateTime    @updatedAt
}

enum EstadoCivil {
  SOLTEIRO
  CASADO
  UNIAO_ESTAVEL
  DIVORCIADO
  VIUVO
}

// ─── DOCUMENTO DO LOTE ────────────────────────────────────────────────────────

model DocumentoLote {
  id                         String   @id @default(cuid())
  loteId                     String   @unique
  lote                       Lote     @relation(fields: [loteId], references: [id], onDelete: Cascade)
  rgFrente                   String?
  rgVerso                    String?
  cpfFoto                    String?
  comprovanteResidencia      String?
  certidaoNascimentoDivorcio String?
  atualizadoEm               DateTime @updatedAt
}

// ─── BENFEITORIA ──────────────────────────────────────────────────────────────

model Benfeitoria {
  id                                   String                    @id @default(cuid())
  loteId                               String                    @unique
  lote                                 Lote                      @relation(fields: [loteId], references: [id], onDelete: Cascade)
  estabilidadeEstrutura                EstabilidadeEstrutura?
  necessidadeReconstrucao              NecessidadeReconstrucao?
  numeroComodos                        Int?
  numeroMoradoresPorComodo             Int?
  numeroBanheiros                      Int?
  condicoesBanheiros                   CondicoesBanheiros?
  materialParedesExternas              MaterialParedesExternas?
  condicoesParedesExternas             CondicoesParedesExternas?
  cobertura                            Cobertura?
  instalacoesEletricas                 String[]
  condicoesInstalacoesEletricas        CondicoesInstalacoes?
  instalacoesHidrossanitarias          String[]
  condicoesInstalacoesHidrossanitarias CondicoesInstalacoes?
  esgotamentoSanitario                 String[]
  condicoesEsgotamentoSanitario        CondicoesEsgotamento?
  atualizadoEm                         DateTime                  @updatedAt
}

enum EstabilidadeEstrutura {
  BOA
  REGULAR
  RUIM
  PESSIMA
}

enum NecessidadeReconstrucao {
  NAO
  PARCIAL
  TOTAL
}

enum CondicoesBanheiros {
  BOM
  REGULAR
  RUIM
}

enum MaterialParedesExternas {
  ALVENARIA
  MADEIRA
  MISTO
  TAIPA
  METALICO
  OUTROS
}

enum CondicoesParedesExternas {
  BOA
  REGULAR
  RUIM
}

enum Cobertura {
  LAJE
  TELHA_CERAMICA
  TELHA_FIBROCIMENTO
  TELHA_METALICA
  PALHA
  OUTROS
}

enum CondicoesInstalacoes {
  BOA
  REGULAR
  RUIM
  AUSENTE
}

enum CondicoesEsgotamento {
  BOA
  REGULAR
  RUIM
  AUSENTE
}
